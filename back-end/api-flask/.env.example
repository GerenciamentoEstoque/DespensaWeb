# Copie este arquivo para .env nesta mesma pasta e substitua os exemplos.
# Nunca publique o .env nem credenciais reais.

# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA

# Execute o comando novamente: use uma chave diferente da chave JWT.
RESET_TOKEN_SECRET=SUBSTITUA_POR_OUTRA_CHAVE_ALEATORIA

# Recuperação de senha: servidor com SSL implícito (SMTP_SSL).
# Use os dados fornecidos pelo seu provedor. A implementação não usa STARTTLS.
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=465
SMTP_EMAIL=seu-email@exemplo.com
# Use uma senha de aplicativo quando exigida pelo provedor.
SMTP_PASSWORD="SUBSTITUA_PELA_CREDENCIAL_SMTP"

# A URI SQLite e os prazos de expiração estão definidos no código,
# não em variáveis de ambiente: JWT de 1.200 minutos (20 horas) e reset de 15 minutos.
